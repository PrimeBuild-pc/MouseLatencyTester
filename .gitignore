# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tests / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local data — never commit measurements or user settings
.local/
*.db
*.db-journal
*.sqlite
*.sqlite3
settings.json
*.csv
!docs/**/*.csv
!hardware/**/*.csv
!outputs/**/*.csv

# KiCad per-user state and editor locks
*.kicad_prl
*.kicad_pcb.lck
*.kicad_sch.lck
~*.lck

# Arduino build output
build*/
*.hex
*.elf
